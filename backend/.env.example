# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Protege a API (header X-API-Key). Vazio desliga a autenticação (apenas dev).
API_KEY=
# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173

# Nome da empresa exibido nas respostas do bot
COMPANY_NAME=SupportBot

# Configurações RAG (opcionais, já têm bons defaults)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
FETCH_K=20
# Similaridade mínima (0 a 1) para responder; abaixo disso vira fallback. Ajuste com o eval.
MIN_RELEVANCE=0.70

# Limites
MAX_UPLOAD_MB=10
MAX_URL_KB=2048
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_INGEST_PER_MIN=10

# Provedor do LLM: gemini | openai | ollama (embeddings seguem no Gemini)
LLM_PROVIDER=gemini
# Vazio usa o padrão do provedor (gemini-2.5-flash-lite, gpt-4o-mini, llama3.1)
LLM_MODEL=
# openai/ollama exigem: pip install -r requirements-optional.txt
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Guardrails de ingestão
# PII_MODE: off | mask | block. PII_TYPES: cpf, email, phone
PII_MODE=mask
PII_TYPES=cpf,email
# E-mails ou domínios que não devem ser mascarados (ex.: suporte@empresa.com,@empresa.com)
PII_ALLOW_EMAILS=
# INJECTION_MODE: off | flag | drop (remove só as frases suspeitas) | block
INJECTION_MODE=drop
MAX_SITEMAP_URLS=20
